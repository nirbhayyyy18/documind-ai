# Cloud PostgreSQL connection (Neon)
DATABASE_URL=

# Gemini API
GEMINI_API_KEY=

# Authentication: use a random secret of at least 32 characters
JWT_SECRET=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Server port (Render supplies PORT automatically)
PORT=5000

# Optional local PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=documind_ai
DB_USER=postgres
DB_PASSWORD=
